<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>ma.jadwal</groupId>
    <artifactId>jadwal-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>JADWAL - Parent</name>
    <description>Plateforme SaaS de génération d'emplois du temps scolaires</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <modules>
        <module>jadwal-common</module>
        <module>jadwal-referentiel</module>
        <module>jadwal-abonnement</module>
        <module>jadwal-enseignant</module>
        <module>jadwal-pedagogie</module>
        <module>jadwal-planning</module>
        <module>jadwal-scolarite</module>
        <module>jadwal-solver</module>
        <module>jadwal-export</module>
        <module>jadwal-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-referentiel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-abonnement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-enseignant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-pedagogie</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-planning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-scolarite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-solver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.jadwal</groupId>
                <artifactId>jadwal-export</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
