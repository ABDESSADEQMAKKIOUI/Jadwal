# Copier ce fichier vers .env puis ajuster les valeurs.
# Toutes les variables ont des valeurs par défaut de développement :
# le projet démarre sans .env, mais changez ces valeurs en production.

# Mot de passe PostgreSQL (utilisateur "jadwal", base "jadwal")
POSTGRES_PASSWORD=jadwal

# Secret de signature des JWT (obligatoirement long et aléatoire en production)
JADWAL_JWT_SECRET=jadwal-dev-secret-change-me-0123456789abcdef

# Mot de passe du compte super-admin seedé au démarrage (admin@jadwal.ma)
JADWAL_ADMIN_PASSWORD=admin123

# Identifiants MinIO (stockage de fichiers — réservé au module d'ingestion des EDT publics)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
