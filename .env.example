# =============================================================
# JADWAL — variables d'environnement
#
# Copier ce fichier vers .env PUIS REMPLACER CHAQUE VALEUR.
# Les marqueurs ci-dessous sont volontairement inutilisables : le backend
# refuse de démarrer si un secret est absent, trop court, ou reprend une
# valeur ayant circulé publiquement.
#
#   cp .env.example .env
#
# .env est ignoré par git : il ne doit jamais être committé.
# =============================================================

# Mot de passe de la base PostgreSQL.
#   Générer :  openssl rand -base64 24
POSTGRES_PASSWORD=A_REMPLACER

# Clé de signature des jetons JWT. C'est LE secret critique : toute
# l'authentification et l'isolation entre établissements en dépendent. Un
# secret devinable permet de forger un jeton de directeur de n'importe
# quelle école, ou de super-admin de la plateforme.
#   Générer :  openssl rand -base64 48
# Contraintes : 32 octets minimum ; les valeurs publiées sont refusées.
JADWAL_JWT_SECRET=A_REMPLACER

# Mot de passe du compte super-admin créé au premier démarrage
# (admin@jadwal.ma). L'adresse est connue : le mot de passe doit être fort.
# Contraintes : 12 caractères minimum ; les valeurs publiées sont refusées.
JADWAL_ADMIN_PASSWORD=A_REMPLACER

# Console MinIO (réservé au module d'ingestion des EDT publics).
#   Générer le mot de passe :  openssl rand -base64 24
MINIO_ROOT_USER=jadwal-minio
MINIO_ROOT_PASSWORD=A_REMPLACER

# Jeu de démonstration (collège complet paramétré). Ne pas activer en production.
JADWAL_DEMO=false
